# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas: URL-encode special characters in the database password.
MONGO_URI=mongodb+srv://<database-user>:<url-encoded-password>@<cluster-host>/nexora?retryWrites=true&w=majority

# Generate locally: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d

# Frontend origins (comma-separated when deployed)
CLIENT_ORIGIN=http://localhost:5173

# Cloudinary (API secret stays only in server/.env)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Initial administrator seeding (used only by npm run seed)
ADMIN_EMAIL=nexoraecommerce1111@gmail.com
ADMIN_SEED_PASSWORD=replace-with-a-strong-unique-password

# Store rules
FREE_DELIVERY_THRESHOLD=4999
DELIVERY_FEE=99
